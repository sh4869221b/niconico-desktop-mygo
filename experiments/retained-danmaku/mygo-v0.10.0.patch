diff --git a/internal/gpu/d3d11/probe_split.go b/internal/gpu/d3d11/probe_split.go
new file mode 100644
--- /dev/null
+++ b/internal/gpu/d3d11/probe_split.go
@@ -0,0 +1,115 @@
+//go:build windows
+
+package d3d11
+
+import (
+ "fmt"
+ "log"
+ "os"
+ "unsafe"
+
+ "github.com/egoist/mygo/internal/gpu"
+ "github.com/egoist/mygo/internal/scene"
+)
+
+var probeComposeVideo = os.Getenv("MYGO_PROBE_SPLIT") == "1"
+var probeNativeSize = os.Getenv("MYGO_PROBE_NATIVE_SIZE") == "1"
+var probeBoundVideo = os.Getenv("MYGO_PROBE_BOUND") == "1"
+
+// Local benchmark only: one untransformed video, one fixed-sized player window.
+// The decoded picture is submitted to a separate DirectComposition visual only
+// when its version changes. The app's original scene is kept intact for logic.
+type probeVideoLayer struct {
+ root, visual, chain uintptr
+ w, h int
+ dest scene.Rect
+ id, version uint64
+ last scene.Rect
+ ops []scene.Op
+ b gpu.Builder
+}
+
+func (v *probeVideoLayer) release(r *Renderer) {
+ if v.visual != 0 && r.probeRoot != 0 {
+  call(r.probeRoot, 17, v.visual)
+  call(r.dcomp, dcompCommit)
+ }
+ free(&v.visual)
+ free(&v.chain)
+ v.b.Release()
+ *v = probeVideoLayer{}
+}
+
+func (r *Renderer) probeSeparate(s *scene.Scene) (scene.Scene, error) {
+ v := &r.probeVideo
+ out := *s
+ if !(r.composed && (probeComposeVideo || probeBoundVideo)) { return out, nil }
+ at := -1
+ for i, op := range s.Ops {
+  if op.Kind == scene.OpImage && op.Image != nil && op.Image.Surface != nil && !op.Transform.Set && !op.Rect.Empty() {
+   at = i
+   break
+  }
+ }
+ if at < 0 {
+  if v.visual != 0 { v.release(r) }
+  return out, nil
+ }
+ op := s.Ops[at]
+ if probeComposeVideo {
+  if err := v.paint(r,s,op); err != nil { return out,err }
+ }
+ v.ops = append(v.ops[:0],s.Ops...)
+ if probeComposeVideo {
+  // Keep original opaque letterboxes/controls; make just the picture
+  // transparent, then let the original comments paint over that hole.
+  v.ops[at] = scene.Op{Kind:scene.OpHole, Rect:op.Rect}
+ } else {
+  // Diagnostic bound: keep all timing and comments, but omit video drawing.
+  v.ops[at] = scene.Op{Kind:scene.OpFill, Rect:op.Rect}
+ }
+ out.Ops = v.ops
+ return out,nil
+}
+
+func (v *probeVideoLayer) paint(r *Renderer,s *scene.Scene,op scene.Op) error {
+ w,h:=s.Width,s.Height
+ if probeNativeSize {w,h=op.Image.W,op.Image.H}
+ if v.chain != 0 && (v.w != w || v.h != h) {v.release(r)}
+ if v.chain == 0 {
+  check := func(h uintptr,what string)error{if failed(h){return fmt.Errorf("probe %s: %x",what,uint32(h))};return nil}
+  desc := swapChainDesc1{Width:uint32(w), Height:uint32(h),Format:formatB8G8R8A8Unorm,SampleCount:1, BufferUsage:0x20,BufferCount:2,Scaling:scalingStretch,SwapEffect:3, AlphaMode:1}
+  if err:=check(call(r.factory,factoryCreateSwapChainComp,r.device,uintptr(unsafe.Pointer(&desc)),0,uintptr(unsafe.Pointer(&v.chain))),"video swapchain");err!=nil{return err}
+  if err:=check(call(r.dcomp,dcompCreateVisual,uintptr(unsafe.Pointer(&v.visual))),"video visual");err!=nil{return err}
+  if err:=check(call(v.visual,dcompVisualSetContent,v.chain),"video content");err!=nil{return err}
+  if err:=check(call(r.probeRoot,16,v.visual,0,0),"add lower video");err!=nil{return err}
+  if err:=check(call(r.dcomp,dcompCommit),"commit");err!=nil{return err}
+  v.w,v.h=w,h
+ }
+ if probeNativeSize && v.dest!=op.Rect {
+  m:=[6]float32{op.Rect.W/float32(w),0,0,op.Rect.H/float32(h),op.Rect.X,op.Rect.Y}
+  if hr:=call(v.visual,8,uintptr(unsafe.Pointer(&m)));failed(hr){return fmt.Errorf("probe video transform: %x",uint32(hr))}
+  if hr:=call(r.dcomp,dcompCommit);failed(hr){return fmt.Errorf("probe video transform commit: %x",uint32(hr))}
+  v.dest=op.Rect
+ }
+ if op.Image.ID()==v.id && op.Image.Version()==v.version && op.Rect==v.last {return nil}
+ var buf,rtv uintptr
+ if hr:=call(v.chain,scGetBuffer,0,uintptr(unsafe.Pointer(&iidID3D11Texture2D)),uintptr(unsafe.Pointer(&buf)));failed(hr){return fmt.Errorf("probe back buffer: %x",uint32(hr))}
+ defer free(&buf)
+ if hr:=call(r.device,devCreateRenderTargetView,buf,0,uintptr(unsafe.Pointer(&rtv)));failed(hr){return fmt.Errorf("probe target view: %x",uint32(hr))}
+ defer free(&rtv)
+ dst:=op
+ if probeNativeSize {dst.Rect=scene.Rect{W:float32(w),H:float32(h)}}
+ once := scene.Scene{Width:w,Height:h,Scale:s.Scale,Ops:[]scene.Op{dst}}
+ built,err:=r.buildScene(&once,&v.b)
+ if err!=nil{return err}
+ if err:=r.drawBuilt(built,&v.b,rtv,nil);err!=nil{return err}
+ r.releaseShared()
+ // Disassociate the render target so destruction and the next draw are safe.
+ call(r.ctx,ctxOMSetRenderTargets,0,0,0)
+ hr:=call(v.chain,scPresent,0,0)
+ if failed(hr){return fmt.Errorf("probe video present: %x",uint32(hr))}
+ v.id,v.version,v.last=op.Image.ID(),op.Image.Version(),op.Rect
+ log.Printf("mygo-probe video %dx%d version=%d",s.Width,s.Height,v.version)
+ return nil
+}
