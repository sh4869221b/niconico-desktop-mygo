diff --git a/internal/gpu/d3d11/probe_retained.go b/internal/gpu/d3d11/probe_retained.go
new file mode 100644
--- /dev/null
+++ b/internal/gpu/d3d11/probe_retained.go
@@ -0,0 +1,150 @@
+//go:build windows
+package d3d11
+
+import (
+ "fmt"
+ "image"
+ "image/draw"
+ "image/png"
+ "log"
+ "math"
+ "os"
+ "strconv"
+ "time"
+ "unsafe"
+
+ "github.com/egoist/mygo/internal/scene"
+)
+
+var retainedProbe = os.Getenv("MYGO_PROBE_RETAIN")
+var retainedCount,_ = strconv.Atoi(os.Getenv("MYGO_PROBE_RETAIN_COUNT"))
+var retainedDXGISurface=guid{0xcafcb56c,0x6ac3,0x4889,[8]byte{0xbf,0x47,0x9e,0x23,0xbb,0xd2,0x60,0xec}}
+type retainedState struct {
+ start time.Time
+ bounds scene.Rect
+ group uintptr
+ labels []*scene.Image
+ surfaces []uintptr
+ ops []scene.Op
+}
+func rflt(v float32) uintptr {return uintptr(math.Float32bits(v))}
+func rdbl(v float64) uintptr {return uintptr(math.Float64bits(v))}
+func rcheck(hr uintptr, what string) error {
+ if failed(hr) {return fmt.Errorf("retained %s: %#x",what,uint32(hr))}
+ return nil
+}
+
+func (p *retainedState) createSurface(r *Renderer, pix *image.RGBA) (out uintptr, err error) {
+ w,h:=pix.Rect.Dx(),pix.Rect.Dy()
+ if err=rcheck(call(r.dcomp,8,uintptr(w),uintptr(h),87,1,uintptr(unsafe.Pointer(&out))),"surface");err!=nil{return}
+ surface:=out
+ defer func(){if err!=nil{free(&surface)}}()
+ var dxgi,tex uintptr
+ var point [2]int32
+ if err=rcheck(call(surface,3,0,uintptr(unsafe.Pointer(&retainedDXGISurface)),uintptr(unsafe.Pointer(&dxgi)),uintptr(unsafe.Pointer(&point))),"begin");err!=nil{return}
+ defer free(&dxgi)
+ if err=rcheck(call(dxgi,0,uintptr(unsafe.Pointer(&iidID3D11Texture2D)),uintptr(unsafe.Pointer(&tex))),"tex");err!=nil{call(surface,4);return}
+ defer free(&tex)
+ pixels:=append([]byte(nil),pix.Pix...)
+ for i:=0;i<len(pixels);i+=4{pixels[i],pixels[i+2]=pixels[i+2],pixels[i]}
+ box:=[6]uint32{uint32(point[0]),uint32(point[1]),0,uint32(point[0]+int32(w)),uint32(point[1]+int32(h)),1}
+ call(r.ctx,ctxUpdateSubresource,tex,0,uintptr(unsafe.Pointer(&box)),uintptr(unsafe.Pointer(&pixels[0])),uintptr(pix.Stride),0)
+ err=rcheck(call(surface,4),"end")
+ return
+}
+
+func (p *retainedState) release(r *Renderer){
+ if p.group!=0{
+  if r.visual!=0 && r.dcomp!=0 {call(r.visual,17,p.group);call(r.dcomp,3)}
+  free(&p.group)
+ }
+ for i:=range p.surfaces{free(&p.surfaces[i])}
+ *p=retainedState{}
+}
+func (p *retainedState) geometry(i int)(x,y,v float32, first float64){
+ label:=p.labels[i%len(p.labels)]
+ b:=p.bounds
+ y=b.Y+float32(i%16)*max(1,(b.H-float32(label.H))/15)
+ if i%6==0{
+  x=b.X+float32((i/6)%4)*max(1,(b.W-float32(label.W))/4)
+  return
+ }
+ v=-(b.W+float32(label.W))/4
+ first=float64((i*37)%100)/25
+ x=b.X+b.W+v*float32(first)
+ return
+}
+func (p *retainedState) initialize(r *Renderer,b scene.Rect) error {
+ p.bounds=b
+ if !r.composed{return fmt.Errorf("retained requires DComp")}
+ if retainedProbe=="B"{
+  if err:=rcheck(call(r.dcomp,7,uintptr(unsafe.Pointer(&p.group))),"group");err!=nil{return err}
+  clip:=[4]float32{b.X,b.Y,b.X+b.W,b.Y+b.H}
+  if err:=rcheck(call(p.group,14,uintptr(unsafe.Pointer(&clip))),"clip");err!=nil{return err}
+  if err:=rcheck(call(r.visual,16,p.group,1,0),"add group");err!=nil{return err}
+ }
+ for i:=0;i<16;i++{
+  file,err:=os.Open(fmt.Sprintf("retained-label-%02d.png",i));if err!=nil{return err}
+  img,err:=png.Decode(file);file.Close();if err!=nil{return err}
+  rgba:=image.NewRGBA(img.Bounds());draw.Draw(rgba,rgba.Bounds(),img,img.Bounds().Min,draw.Src)
+  p.labels=append(p.labels,scene.NewImage(rgba))
+  if retainedProbe=="B"{
+   u,e:=p.createSurface(r,rgba);if e!=nil{return e};p.surfaces=append(p.surfaces,u)
+  }
+ }
+ if retainedProbe=="B" {
+  for i:=0;i<retainedCount;i++{
+   if err:=p.child(r,i);err!=nil{return err}
+  }
+  if err:=rcheck(call(r.dcomp,3),"commit");err!=nil{return err}
+ }
+ p.start=time.Now()
+ log.Printf("retained-probe mode=%s count=%d bounds=%+v",retainedProbe,retainedCount,b)
+ return nil
+}
+func (p *retainedState) child(r *Renderer,i int) error {
+ var child,anim uintptr
+ if e:=rcheck(call(r.dcomp,7,uintptr(unsafe.Pointer(&child))),"child");e!=nil{return e}
+ defer free(&child)
+ x,y,v,first:=p.geometry(i)
+ if e:=rcheck(call(child,6,rflt(y)),"y");e!=nil{return e}
+ if v==0{
+  if e:=rcheck(call(child,4,rflt(x)),"x");e!=nil{return e}
+ }else{
+  if e:=rcheck(call(r.dcomp,25,uintptr(unsafe.Pointer(&anim))),"animation");e!=nil{return e}
+  defer free(&anim)
+  if e:=rcheck(call(anim,5,0,rflt(x),rflt(v),0,0),"cubic 1");e!=nil{return e}
+  if e:=rcheck(call(anim,5,rdbl(4-first),rflt(p.bounds.X+p.bounds.W),rflt(v),0,0),"cubic 2");e!=nil{return e}
+  if e:=rcheck(call(anim,7,rdbl(8-first),rdbl(4)),"repeat");e!=nil{return e}
+  if e:=rcheck(call(child,3,anim),"animate x");e!=nil{return e}
+ }
+ if e:=rcheck(call(child,15,p.surfaces[i%len(p.surfaces)]),"content");e!=nil{return e}
+ return rcheck(call(p.group,16,child,1,0),"add child")
+}
+func (p *retainedState) frame(r *Renderer,s *scene.Scene)(scene.Scene,error){
+ out:=*s
+ if retainedProbe==""||retainedCount<=0{return out,nil}
+ var b scene.Rect
+ for _,op:=range s.Ops{
+  if op.Kind==scene.OpImage&&op.Image!=nil&&op.Image.Surface!=nil&&!op.Transform.Set&&!op.Rect.Empty(){b=op.Rect;break}
+ }
+ if b.Empty(){if !p.start.IsZero(){p.release(r)};return out,nil}
+ if b!=p.bounds||p.start.IsZero(){
+  p.release(r)
+  if err:=p.initialize(r,b);err!=nil{p.release(r);return out,err}
+ }
+ if retainedProbe!="A"{return out,nil}
+ p.ops=append(p.ops[:0],s.Ops...)
+ p.ops=append(p.ops,scene.Op{Kind:scene.OpPushClip,Rect:b})
+ sec:=time.Since(p.start).Seconds()
+ for i:=0;i<retainedCount;i++{
+  label:=p.labels[i%len(p.labels)]
+  x,y,v,first:=p.geometry(i)
+  if v!=0{x=b.X+b.W+v*float32(math.Mod(sec+first,4))}
+  p.ops=append(p.ops,scene.Op{Kind:scene.OpImage,Rect:scene.Rect{X:x,Y:y,W:float32(label.W),H:float32(label.H)}, Image:label})
+ }
+ p.ops=append(p.ops,scene.Op{Kind:scene.OpPopClip})
+ out.Ops=p.ops
+ return out,nil
+}
+
diff --git a/internal/gpu/d3d11/probe_retained_real.go b/internal/gpu/d3d11/probe_retained_real.go
new file mode 100644
--- /dev/null
+++ b/internal/gpu/d3d11/probe_retained_real.go
@@ -0,0 +1,118 @@
+//go:build windows
+package d3d11
+
+import (
+ "fmt"
+ "image"
+ "log"
+ "math"
+ "os"
+ "time"
+ "unsafe"
+ "github.com/egoist/mygo/internal/scene"
+)
+var retainedStats = os.Getenv("MYGO_PROBE_COMPOSITION_STATS") == "1"
+var realRetained = os.Getenv("MYGO_PROBE_RETAIN") == "D"
+type probeTexture struct { ptr uintptr; refs int }
+type realRetainedItem struct { visual uintptr; pixels *image.RGBA; revision int64 }
+type realRetainedState struct {
+ group uintptr
+ clip [4]float32
+ generation int64
+ origin time.Time
+ media float64
+ playing bool
+ items map[int64]realRetainedItem
+ textures map[*image.RGBA]*probeTexture
+ traceTag int
+ lastStats time.Time
+}
+func (p *realRetainedState) release(r *Renderer) {
+ if p.group!=0 {
+  call(r.visual,17,p.group)
+  call(r.dcomp,3)
+  free(&p.group)
+ }
+ for _,v:=range p.items {free(&v.visual)}
+ for _,t:=range p.textures{free(&t.ptr)}
+ *p=realRetainedState{}
+}
+func (p *realRetainedState) frame(r *Renderer,s *scene.Scene) error {
+ if !realRetained&&!retainedStats{return nil}
+ var picture scene.Rect
+ for _,op:=range s.Ops {
+  if op.Kind==scene.OpImage&&op.Image!=nil&&op.Image.Surface!=nil&&!op.Transform.Set&&!op.Rect.Empty(){picture=op.Rect;break}
+ }
+ if picture.Empty(){if p.group!=0{p.release(r)};return nil}
+ if retainedStats&&r.composed&&time.Since(p.lastStats)>=250*time.Millisecond {
+  p.lastStats=time.Now()
+  var f struct{ last int64; num,den uint32; now,freq,next int64 }
+  if hr:=call(r.dcomp,5,uintptr(unsafe.Pointer(&f)));!failed(hr)&&f.den!=0&&f.freq>0{
+   log.Printf("composition nominal %.3f current=%d last=%d next=%d freq=%d",float64(f.num)/float64(f.den),f.now,f.last,f.next,f.freq)
+  }
+ }
+ if !realRetained{return nil}
+ f:=scene.ExperimentalRetained
+ if !f.Enabled || f.Bounds.W<=0 || f.Bounds.H<=0 {if p.group!=0{p.release(r)};return nil}
+ if !r.composed{return fmt.Errorf("real retained requires DComp")}
+ scale:=s.Scale;if scale<=0{scale=1}
+ clip:=[4]float32{picture.X+(picture.W-f.Bounds.W*scale)/2,picture.Y,picture.X+(picture.W+f.Bounds.W*scale)/2,picture.Y+f.Bounds.H*scale}
+ if p.group!=0 && p.clip!=clip {p.release(r)}
+ changed:=false
+ if p.group==0 {
+  if e:=rcheck(call(r.dcomp,7,uintptr(unsafe.Pointer(&p.group))),"real group");e!=nil{return e}
+  if e:=rcheck(call(p.group,14,uintptr(unsafe.Pointer(&clip))),"real clip");e!=nil{return e}
+  if e:=rcheck(call(r.visual,16,p.group,1,0),"real add");e!=nil{return e}
+  p.clip=clip
+  p.items=make(map[int64]realRetainedItem)
+  p.textures=make(map[*image.RGBA]*probeTexture)
+  changed=true
+  log.Printf("real-retained start clip=%v scale=%g",clip,scale)
+ }
+ now:=time.Now(); seconds:=float64(f.Ms)/1000
+ predicted:=p.media
+ if p.playing {predicted+=now.Sub(p.origin).Seconds()}
+ rebase:=changed || p.playing!=f.Playing || math.Abs(seconds-predicted)>0.09
+ if rebase {p.media,p.origin,p.playing=seconds,now,f.Playing;p.generation++}
+ for id, v:=range p.items {
+  found:=false
+  for _,c:=range f.Items {if id==c.ID{found=true;break}}
+  if !found {call(p.group,17,v.visual);free(&v.visual);if tex:=p.textures[v.pixels];tex!=nil{tex.refs--;if tex.refs==0{free(&tex.ptr);delete(p.textures,v.pixels)}};delete(p.items,id);changed=true}
+ }
+ var previousVisual uintptr
+ for _,c:=range f.Items {
+  v,ok:=p.items[c.ID]
+  if !ok {
+   var e error
+   tex:=p.textures[c.Pixels]
+   if tex==nil{tex=&probeTexture{};tex.ptr,e=r.retained.createSurface(r,c.Pixels);if e!=nil{return e};p.textures[c.Pixels]=tex;if c.Pixels.Bounds().Dx()>2200 && os.Getenv("MYGO_PROBE_DIAG")=="1" {log.Printf("wide surface cue=%d width=%d height=%d",c.ID,c.Pixels.Bounds().Dx(),c.Pixels.Bounds().Dy())}}
+   if e=rcheck(call(r.dcomp,7,uintptr(unsafe.Pointer(&v.visual))),"real visual");e!=nil{return e}
+   v.pixels=c.Pixels;tex.refs++;p.items[c.ID]=v
+   if e=rcheck(call(v.visual,15,tex.ptr),"real content");e!=nil{return e}
+   if e=rcheck(call(v.visual,6,rflt(clip[1]+c.Y*scale)),"real y");e!=nil{return e}
+   if e=rcheck(call(p.group,16,v.visual,1,previousVisual),"real child");e!=nil{return e}
+   changed=true
+  }
+  previousVisual=v.visual
+  if !ok||v.revision!=p.generation {
+   if e:=rcheck(call(v.visual,6,rflt(clip[1]+c.Y*scale)),"real y rebase");e!=nil{return e}
+   x:=clip[0]+c.X*scale
+   if f.Playing&&c.Speed!=0&&c.End>f.Ms {
+    var a uintptr
+    if e:=rcheck(call(r.dcomp,25,uintptr(unsafe.Pointer(&a))),"real animation");e!=nil{return e}
+    remain:=float64(c.End-f.Ms)/1000
+    e:=rcheck(call(a,5,0,rflt(x),rflt(c.Speed*scale),0,0),"real cubic")
+    if e==nil {e=rcheck(call(a,8,rdbl(remain),rflt(x+c.Speed*scale*float32(remain))),"real end")}
+    if e==nil {e=rcheck(call(v.visual,3,a),"real offset anim")}
+    free(&a);if e!=nil{return e}
+   }else{
+    if e:=rcheck(call(v.visual,4,rflt(x)),"real x");e!=nil{return e}
+   }
+   v.revision=p.generation;p.items[c.ID]=v;changed=true
+  }
+ }
+ if changed{if err:=rcheck(call(r.dcomp,3),"real commit");err!=nil{return err}}
+ if os.Getenv("MYGO_BENCH_CONTROL")=="1" && int(f.Ms/250)!=p.traceTag { p.traceTag=int(f.Ms/250);ids:=[]int64{};for _,c:=range f.Items{if _,ok:=p.items[c.ID];ok{ids=append(ids,c.ID)}};log.Printf("cue submitted ms=%d ids=%v",f.Ms,ids) }
+ return nil
+}
