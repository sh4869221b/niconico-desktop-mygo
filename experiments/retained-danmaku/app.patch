diff --git a/local_retained.go b/local_retained.go
new file mode 100644
--- /dev/null
+++ b/local_retained.go
@@ -0,0 +1,77 @@
+package main
+import (
+ "image"
+ "log"
+ "math"
+ "os"
+ "github.com/egoist/mygo/ui"
+)
+var realAppRetained = os.Getenv("MYGO_PROBE_RETAIN")=="D"
+var realRetainedPlaying=true
+type realSpriteKey struct { body string; size,w,h,stroke float32; rgb uint32; fixed bool }
+func retainedBitmapKey(c *drawnComment,stroke float32) realSpriteKey {return realSpriteKey{c.body,c.fontSize,c.width,c.height,stroke,c.style.rgb,c.style.position!=scrollComment}}
+var realSprites=make(map[realSpriteKey]*image.RGBA)
+var realSpriteBytes int
+var realTraceMs int64
+var controlTraceTag = -1
+var controlTraceMS int64
+func traceLogicalCues(d *danmakuOverlay, r ui.Rect, ms int64) {
+ if os.Getenv("MYGO_BENCH_CONTROL")!="1"{ return }
+ tag:=int(ms/250);if tag==controlTraceTag && ms>=controlTraceMS {return};controlTraceTag,controlTraceMS=tag,ms
+ ids:=[]int64{};for _,c:=range d.active {x:=(r.W-c.width)/2;if c.style.position==scrollComment{x=c.x(ms,r.W)};if x<r.W && x+c.width>0{ids=append(ids,c.probeID)}}
+ log.Printf("cue logical ms=%d ids=%v",ms,ids)
+}
+func (d *danmakuOverlay) retain(r ui.Rect, ms int64, stroke float32) bool {
+ const pad=5;const maxSpriteBytes=2<<20; activeBytes:=0
+ activeImages:=make(map[realSpriteKey]*image.RGBA,len(d.active))
+ for _,c:=range d.active {
+  x:=(r.W-c.width)/2
+  if c.style.position==scrollComment {x=c.x(ms,r.W)}
+  if x>=r.W||x+c.width<=0 {continue}
+  k:=retainedBitmapKey(&c,stroke)
+  if _,seen:=activeImages[k];!seen{activeBytes+=int(math.Ceil(float64(c.width+2*pad)))*int(math.Ceil(float64(c.height+2*pad)))*4;activeImages[k]=nil}
+  if c.bitmap!=nil{activeImages[k]=c.bitmap}
+  if activeBytes>64<<20||c.width+2*pad>8192||c.height+2*pad>750||int(math.Ceil(float64(c.width+2*pad)))*int(math.Ceil(float64(c.height+2*pad)))*4>maxSpriteBytes {
+   if os.Getenv("MYGO_PROBE_DIAG")=="1" && ms-realTraceMs>=500 {realTraceMs=ms;log.Printf("real fallback ms=%d width=%g height=%g",ms,c.width,c.height)}
+   return false
+  }
+ }
+ items:=make([]ui.ProbeRetainedCue,0,len(d.active))
+ outX, oversize, rasterized:=0,0,0
+ for i:=range d.active {
+  c:=&d.active[i]
+  x:=(r.W-c.width)/2
+  speed:=float32(0)
+  if c.style.position==scrollComment {
+   x=c.x(ms,r.W)
+   speed=-(r.W+c.width)*1000/float32(c.end-c.start)
+  }
+  if x>=r.W||x+c.width<=0{outX++;continue}
+  w:=int(math.Ceil(float64(c.width+pad*2)))
+  h:=int(math.Ceil(float64(c.height+pad*2)))
+  if w<=0||h<=0||w>8192||h>750{oversize++;continue}
+  probeVisible++
+  k:=retainedBitmapKey(c,stroke)
+  img:=activeImages[k]; if img==nil {img=realSprites[k]}
+  if img==nil {
+   if realSpriteBytes+w*h*4>8<<20 {clear(realSprites);realSpriteBytes=0}
+   rasterized++
+   img=ui.Render(func(ctx *ui.Context){
+    ctx.Root().Background(ui.Transparent)
+    rgb:=c.style.rgb
+    color:=ui.RGB(uint8(rgb>>16),uint8(rgb>>8),uint8(rgb))
+    border:=ui.RGB(0,0,0);if rgb==0{border=ui.RGB(255,255,255)}
+    label:=ui.Text(ctx,c.body).Absolute().Left(pad).Top(pad).Width(c.width+0.5).
+     Font("Arial").FontSize(c.fontSize).FontWeight(700).Lang("ja").LineHeight(1.15).NoWrap().
+     TextColor(color).TextStroke(stroke,border)
+    if k.fixed{label.TextAlign(ui.Center)}
+   },w,h,1)
+   realSprites[k]=img;realSpriteBytes+=w*h*4
+  }
+  c.bitmap=img;activeImages[k]=img
+  items=append(items,ui.ProbeRetainedCue{ID:c.probeID,End:c.end,X:x-pad,Y:c.y-pad,Speed:speed,Pixels:img})
+ }
+ if os.Getenv("MYGO_PROBE_DIAG")=="1" && ms-realTraceMs>=500{realTraceMs=ms;log.Printf("real diag ms=%d active=%d out=%d over=%d retained=%d active_bytes=%d raster=%d",ms,len(d.active),outX,oversize,len(items),activeBytes,rasterized)}
+ ui.ProbeRetained(r,ms,realRetainedPlaying,true,items)
+ return true
+}
