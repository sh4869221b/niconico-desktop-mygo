diff --git a/local_bench_test.go b/local_bench_test.go
new file mode 100644
--- /dev/null
+++ b/local_bench_test.go
@@ -0,0 +1,145 @@
+package main
+import(
+ "context"
+ "encoding/json"
+ "fmt"
+ "os"
+ "testing"
+"syscall"
+"unsafe"
+ "time"
+ "github.com/egoist/mygo"
+)
+var probeVisible, probeFrames, probeMax, probeTotal int
+func benchFrame(){probeFrames++; probeTotal+=probeVisible; probeMax=max(probeMax,probeVisible);probeVisible=0}
+type measuredVideo struct {
+ OverlayFrames, VisibleMax, VisibleTotal int
+ Pos, Duration float64
+ W,H int
+ Total,Dropped int
+ Paused bool
+}
+func TestMain(m *testing.M){
+if os.Getenv("MYGO_PARITY_MODE")!=""{localDanmakuParity();return}
+ mode:=os.Getenv("MYGO_BENCH_MODE")
+ if mode==""{os.Exit(m.Run())}
+ b:=&browser{index:-1}
+ dest:=os.Getenv("MYGO_BENCH_OUT")
+ raw:=home+"watch/"+os.Getenv("MYGO_BENCH_VID")
+ session:=os.Getenv("MYGO_BENCH_SESSION")
+ mark:=func(key string,v any){
+    data,_:=json.Marshal(v)
+    if err:=os.WriteFile(dest+"/"+key+".json",data,0600);err!=nil {fmt.Println(err)}
+ }
+ exit:=1
+ mygo.App.SetName("MyGo Player Benchmark")
+ mygo.App.WhenReady(func(){
+   b.start(home)
+   b.session=mygo.NewSession(session)
+   mark("baseline",true)
+   go func(){
+     time.Sleep(4*time.Second)
+     var started time.Time
+     pMode:=playbackMode(mode)
+     mygo.RunOnMain(func(){ started=time.Now();mark("opening",true);b.openPlayerMode(raw,pMode) })
+     var sample measuredVideo
+     var steady time.Time
+     lastError:=""; assisted:=false
+     for time.Since(started)<55*time.Second {
+       time.Sleep(125*time.Millisecond)
+       // Observe only at start and finish, not during resource sampling.
+       if !steady.IsZero()&&time.Since(steady)<22*time.Second{continue}
+       done:=false
+       mygo.RunOnMain(func(){
+         p:=b.player
+         if p==nil{return}
+         if mode=="native"&&p.native!=nil&&p.native.stream!=nil {
+            s:=p.native.stream
+            if e:=s.Err();e!=nil{lastError="native media error";return}
+            sample.Pos=s.Position().Seconds(); sample.Duration=s.Duration().Seconds()
+            sample.W,sample.H=s.Size()
+            sample.Paused=!s.Playing(); sample.OverlayFrames, sample.VisibleMax,sample.VisibleTotal=probeFrames,probeMax,probeTotal
+         }else if mode=="webview"&&p.view!=nil&&p.loadedURL!=""{
+            page:=p.view.Page()
+            mark("pids",[]int{page.ProcessID(),page.GPUProcessID()})
+            ctx,stop:=context.WithTimeout(context.Background(),time.Second)
+            v,err:=page.EvalContext(ctx,`const v=document.querySelector('video'); if (!v) return null; const q=v.getVideoPlaybackQuality(); return {Pos:v.currentTime,Duration:isFinite(v.duration)?v.duration:0,W:v.videoWidth,H:v.videoHeight,Total:q.totalVideoFrames,Dropped:q.droppedVideoFrames,Paused:v.paused};`)
+            stop()
+            if err!=nil{lastError=err.Error();return}
+            if v==nil{lastError="no HTML video element";return}
+            data,_:=json.Marshal(v); if e:=json.Unmarshal(data,&sample);e!=nil{lastError=e.Error();return}
+         }else{return}
+         if steady.IsZero(){
+           expected:=0.0
+           if os.Getenv("MYGO_BENCH_VID")=="sm9"{expected=320}
+           // Request the site's standard play mechanism only if guest autoplay has not started.
+           if mode=="webview"&&sample.Paused&&sample.Pos==0&&sample.W>0&&!assisted&&time.Since(started)>6*time.Second{
+              assisted=true;mark("played",true)
+              page:=p.view.Page()
+              ctx,stop:=context.WithTimeout(context.Background(),time.Second)
+              _,_ = page.EvalContext(ctx,"const v=document.querySelector('video'); if(v) v.play().catch(()=>{}); return true;")
+              stop()
+           }
+           if expected>0&&sample.Duration>0&&(sample.Duration<expected-3||sample.Duration>expected+3){
+             lastError="not the requested video's duration"; return
+           }
+           if sample.Pos<0.10||sample.W<=0||sample.H<=0 {lastError=fmt.Sprintf("not moving: %+v",sample);return}
+           mark("start",map[string]any{"seconds":time.Since(started).Seconds(),"video":sample})
+           steady=time.Now(); runRetainedControlProof(b,mark); probeFrames,probeMax,probeTotal=0,0,0
+         }else{
+           mark("end",sample)
+           exit=0;done=true;mygo.App.Quit()
+         }
+       })
+       if done{return}
+     }
+     mygo.RunOnMain(func(){
+      mark("error",lastError);fmt.Println("benchmark timeout:",lastError);mygo.App.Quit()
+     })
+   }()
+ })
+ if err:=mygo.App.Run();err!=nil{fmt.Println(err)}
+ os.Exit(exit)
+}
+
+// Only used by the benchmark. Click the visible video in the verified app
+// window so Chromium receives the same activation as a local user click.
+func clickBenchVideo(p *playerWindow)bool {
+ u:=syscall.NewLazyDLL("user32.dll")
+ hwnd:=p.win.NativeHandle()
+ if hwnd==0{return false}
+ type pos struct {X,Y int32}
+ type hit struct { X,Y,R float64 }
+ var h hit
+ page:=p.view.Page()
+ ctx,stop:=context.WithTimeout(context.Background(),time.Second)
+ defer stop()
+ got,err:=page.EvalContext(ctx,"const v=document.querySelector('video'); if(!v)return null; const b=v.getBoundingClientRect(); return {X:b.x+b.width/2,Y:b.y+b.height/2,R:devicePixelRatio};")
+ if err!=nil||got==nil{return false}
+ js,_:=json.Marshal(got)
+ if json.Unmarshal(js,&h)!=nil||h.X<10||h.Y<10||h.R<=0{return false}
+ p.win.Focus()
+ fg,_,_:=u.NewProc("GetForegroundWindow").Call()
+ if fg!=hwnd{u.NewProc("SetForegroundWindow").Call(hwnd);fg,_,_=u.NewProc("GetForegroundWindow").Call()}
+ if fg!=hwnd{fmt.Println("unable to activate only the test window");return false}
+ target:=pos{int32(h.X*h.R),int32(h.Y*h.R)}
+ ok,_,_:=u.NewProc("ClientToScreen").Call(hwnd,uintptr(unsafe.Pointer(&target)))
+ if ok==0{return false}
+ arg:=uintptr(uint64(uint32(target.X))|uint64(uint32(target.Y))<<32)
+ child,_,_:=u.NewProc("WindowFromPoint").Call(arg)
+ ancestor,_,_:=u.NewProc("GetAncestor").Call(child,2)
+ if ancestor!=hwnd{fmt.Println("video click target is not the test window");return false}
+ var old pos
+ u.NewProc("GetCursorPos").Call(uintptr(unsafe.Pointer(&old)))
+ move:=u.NewProc("SetCursorPos"); moved,_,_:=move.Call(uintptr(target.X),uintptr(target.Y)); if moved==0{return false}
+ fg,_,_=u.NewProc("GetForegroundWindow").Call()
+ if fg==hwnd{
+  click:=u.NewProc("mouse_event");click.Call(2,0,0,0,0);click.Call(4,0,0,0,0)
+ }
+ move.Call(uintptr(old.X),uintptr(old.Y))
+ return fg==hwnd
+}
+
+
+
+
