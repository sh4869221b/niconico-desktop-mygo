+package main
+import (
+ "time"
+ "os"
+ "github.com/egoist/mygo"
+)
+
+func runRetainedControlProof(b *browser, mark func(string,any)) {
+ if os.Getenv("MYGO_BENCH_CONTROL")!="1"{return}
+ step:=func(name string, action func(*playerWindow)){
+  mygo.RunOnMain(func(){
+   p:=b.player
+   if p==nil||p.native==nil||p.native.stream==nil{return}
+   action(p)
+   s:=p.native.stream
+   mark("state-"+name,map[string]any{"pos":s.Position().Seconds(),"playing":s.Playing(),"wallUnixMS":time.Now().UnixMilli()})
+  })
+ }
+ go func(){
+  noop:=func(*playerWindow){}
+  time.Sleep(13*time.Second)
+  step("pause",func(p *playerWindow){p.native.stream.Pause();p.win.Invalidate()})
+  time.Sleep(700*time.Millisecond)
+  step("paused-a",noop)
+  time.Sleep(700*time.Millisecond)
+  step("paused-b",noop)
+  time.Sleep(600*time.Millisecond)
+  step("seek",func(p *playerWindow){p.native.stream.Seek(8*time.Second);p.win.Invalidate()})
+  time.Sleep(1200*time.Millisecond)
+  step("seek-paused",noop)
+  time.Sleep(700*time.Millisecond)
+  step("resume",func(p *playerWindow){p.native.stream.Play();p.win.Invalidate()})
+  time.Sleep(1500*time.Millisecond)
+  step("resumed",noop)
+ }()
+}
+
