+func localDanmakuParity() {
+ mode:=playbackMode(os.Getenv("MYGO_PARITY_MODE"))
+ mygo.App.SetName("MyGo Danmaku Parity")
+ id:=os.Getenv("MYGO_PARITY_VIDEO")
+ if id=="" {id="sm9"}
+ raw:=home+"watch/"+id
+ b:=&browser{index:-1,noHistory:raw}
+ mygo.App.WhenReady(func(){
+  b.session=mygo.NewSession("parity-"+string(mode))
+  var direct *mygo.Window; if mode==webPlayback { _=setJapaneseComments(b.session.Cookies.Set,time.Now()); direct=mygo.NewWindow(mygo.WindowOptions{Title:"Official player comparison",URL:raw,Width:1060,Height:700, Page:mygo.PageOptions{Untrusted:true,Session:b.session,DevTools:mygo.DevToolsDisabled}}) } else { b.openPlayerMode(raw,mode) }
+  go func(){
+   until:=time.Now().Add(38*time.Second)
+   seeking:=false
+   var at float64; seekAt:=time.Time{}; var data []string
+   for time.Now().Before(until) {
+    time.Sleep(400*time.Millisecond)
+    done:=false
+    mygo.RunOnMain(func(){
+     p:=b.player
+     if p==nil&&direct==nil{return}
+     if mode==nativePlayback {
+      n:=p.native
+      if n==nil||n.stream==nil||!n.stream.Ready()||len(n.comments)==0{return}
+      if !seeking {seeking=true;seekAt=time.Now();n.stream.Pause();n.stream.Seek(24_700*time.Millisecond);return}
+      at=n.stream.Position().Seconds()
+      if at<24.65||at>24.75||time.Since(seekAt)<1700*time.Millisecond{return}
+     } else {
+      if direct==nil{return}
+      ctx,cancel:=context.WithTimeout(context.Background(),1200*time.Millisecond)
+      defer cancel()
+      if !seeking {
+       x,_:=direct.Page().EvalContext(ctx,"const v=document.querySelector('video'); if (!v || !v.videoWidth) return false; v.muted=true; v.pause(); v.currentTime=25.34; return true;")
+       seeking=x==true;if seeking{seekAt=time.Now()};return
+      }
+      x,err:=direct.Page().EvalContext(ctx,"const v=document.querySelector('video'); if(!v|| v.seeking || v.readyState<2) return null; return {sec:v.currentTime, video:[v.getBoundingClientRect().x,v.getBoundingClientRect().y,v.clientWidth,v.clientHeight], canvases:[...document.querySelectorAll('canvas')].map(c=>[c.width,c.height,c.getBoundingClientRect().x,c.getBoundingClientRect().y,c.clientWidth,c.clientHeight])};")
+      if err!=nil||x==nil || time.Since(seekAt)<1600*time.Millisecond{return}
+      fmt.Println("official",x)
+     }
+     var png []byte
+     var err error
+     if mode==webPlayback {
+       ctx,cancel:=context.WithTimeout(context.Background(),2*time.Second)
+       defer cancel()
+       x,e:=direct.Page().EvalContext(ctx,"const v=document.querySelector('video');v.pause();return [...document.querySelectorAll('canvas')].filter(c=>c.clientWidth>0).map(c=>c.toDataURL());")
+       if e==nil{if xs,ok:=x.([]any);ok{for _,d:=range xs{ if raw,ok:=d.(string);ok{data=append(data,raw)} }}}
+       for i,d:=range data { _,b,ok:=strings.Cut(d,",");if ok{raw,_:=base64.StdEncoding.DecodeString(b);_ = os.WriteFile(fmt.Sprintf("local-parity-overlay-%d.png",i),raw,0600)}}
+     }
+     if direct!=nil {png,err=direct.CapturePage()} else {png,err=p.win.CapturePage()}
+     fmt.Println("capture",mode,len(png),at,err)
+     if err==nil { _=os.WriteFile("local-parity-"+string(mode)+".png",png,0600) }
+     done=true
+     mygo.App.Quit()
+    })
+    if done{return}
+   }
+   mygo.RunOnMain(func(){fmt.Println("capture timed out",mode);mygo.App.Quit()})
+  }()
+ })
+ if err:=mygo.App.Run();err!=nil{fmt.Println(err)}
+}
